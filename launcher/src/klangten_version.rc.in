// Version resource of the Windows programs. CMakeLists.txt (klangten_add_version_resource)
// fills it in per program; FileDescription is what the Task Manager shows as the name.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @KLANGTEN_VERSION_COMMAS@,0
 PRODUCTVERSION @KLANGTEN_VERSION_COMMAS@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "sixdotsIT"
      VALUE "FileDescription", "@KLANGTEN_RC_DESCRIPTION@"
      VALUE "FileVersion", "@KLANGTEN_VERSION@"
      VALUE "InternalName", "@KLANGTEN_RC_INTERNAL_NAME@"
      VALUE "LegalCopyright", "Copyright (C) 2014-2026 Dawid Pieper; modifications Copyright (C) 2026 Felix Valentin Herwig (sixdotsIT). GNU GPL v3."
      VALUE "OriginalFilename", "@KLANGTEN_RC_ORIGINAL_FILENAME@"
      VALUE "ProductName", "Klangten"
      VALUE "ProductVersion", "@KLANGTEN_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
