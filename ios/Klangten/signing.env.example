# Copy this file to `signing.env` and fill in your details, then re-run
# ./assemble.sh . Your signing then persists across every project regeneration.
#
# DEVELOPMENT_TEAM: your 10-character Team ID. Find it with either:
#   * Xcode → Settings → Accounts → your Apple ID → team is listed with its ID, or
#   * security find-certificate -c "Apple Development" -p | \
#       openssl x509 -noout -subject   (the OU=... value is your Team ID)
DEVELOPMENT_TEAM=ABCDE12345

# Optional: a bundle id that is unique to you (must not clash with anyone else).
BUNDLE_ID=com.yourname.elten
